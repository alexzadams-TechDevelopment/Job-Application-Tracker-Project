@{
    ViewData["Title"] = "About Page";
    ViewData["FullWidth"] = true;
}

<link rel="stylesheet" href="~/css/About.css" />


<div class="introBox1">
    <h1 class="introHeader1"> About [JobApplicationProject]</h1>
    <div class="intro1Subox">
        <p class="headerText">
            The [JobApplicationProject] is job application tracker website that allows users to enter all the infomation related to
            placements that you plan to apply to and the status of each job in a organised table. Users will have the freedom to 
            enter jobs, order them by the current application status and track by name, application time, location and role to,
            have a visual display of all the jobs in one place that can be searched or sorted seperately.
        </p>
        <img src="~/Images/aboutImg1.jpg" alt="Logo" class="introImg1"> @* Open Source Image origin: https://unsplash.com/photos/turned-off-laptop-computer-CH8Xq9ymSaw *@
    </div>
</div>


<div class="introBox2">
    <h1 class="introHeader2"> Creation of the project</h1>
    <div class="intro2Subox">
        <img src="~/Images/aboutImg2.jpg" alt="Logo" class="introImg2"> @* Open Source Image origin: https://unsplash.com/photos/monitor-showing-java-programming-OqtafYT5kTw *@
        <p class="headerText">
            The creation of [JobApplicationProject] is a show of how full-stack website development can be used involving MVC design
            Patterns using ASP.NET within visual studio to combine C# with website markup languages
        </p>
        
    </div>
</div>




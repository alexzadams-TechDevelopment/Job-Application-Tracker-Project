@{
    ViewData["Title"] = "Home Page";
    ViewData["FullWidth"] = true;
}

<link rel="stylesheet" href="~/css/Index.css" />


<div class="introBox">


    <video autoplay muted playsinline>
        <source src="~/Videos/introVideo.mp4" type="video/mp4" /> @* Open Source Video origin: https://www.pexels.com/video/mesmerizing-abstract-light-loop-background-39310521/ *@
        Error: Your browser does not support the video.  
    </video>

    <div class="introSubBox">



        <h1 class="introHeader">Career Track</h1>
        <p class="introText">Tracking Made Simple</p>

        <button class="btn1"> <asp-area="" asp-controller="Home"  asp-action="About"></a>About</button>
        <button class="btn1"><asp-area="" asp-controller="Jobs" asp-action="Index">Track Now</a></button>

    </div>

</div>

<div class ="infoBox1">
    <h1>Tracking Applications Made Simple</h1>
    <div class="info1Subox">
        <p class="subText">Welcome! Our goal with Career Track is to allow users to manage and understand the progress of each individual
            job application within a single simplified table to help users to manage the careers that they apply to. Career Track is designed 
            to be easy to use allowing users to start right away and store their applications to keep track of important details, including the 
            role, company name, date applied and current application status.
        </p>

        
        <img src="~/Images/indexImg1.jpg" alt="Logo" class="infoImg1">  @* Open Source Image origin: https://unsplash.com/photos/a-person-holding-a-piece-of-paper-over-a-laptop-9PwLeZA-RGc *@
    </div>

</div>

<div class ="infoBox1">
    <h1>Where To Begin</h1>
    

    <div class="info1Subox">
        <p class="subText">
            Begin tracking your applications today by creating an account. You can then create your own personal table to add, store and edit the job applications that
            you have made. Applications added to your table will be easily accessible, with sorting and search features available to help you manage your records. 
            Additionally, job statuses will be displayed on a visual dashboard, providing a graphical overview of the progress and current stages of each application.
        </p>
        <img src="~/Images/introBoxImg1.jpg" alt="Logo" class="infoImg1">  @* Open Source Image origin: https://unsplash.com/photos/group-of-people-using-laptop-computer-QckxruozjRg *@
    </div>

    

</div>


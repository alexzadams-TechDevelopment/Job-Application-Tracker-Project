@model IEnumerable<JobApplicationTracker.Models.Job>

@{
    ViewData["Title"] = "Index";
}

<link rel="stylesheet" href="~/css/JobList.css" />
<script src="~/js/job.js"></script>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<h1 class="h1">Welcome</h1>

<div class="dashboard">
    <div class="status-summary">

        <h3>Job Application Summary</h3>

        <ul>
            <li class="unApplied">Unapplied: <span id="unAppliedCount">0</span></li>
            <li class="pending">Pending: <span id="pendingCount">0</span></li>
            <li class="noReply">No Reply: <span id="noReplyCount">0</span></li>
            <li class="rejected">Rejected: <span id="rejectedCount">0</span></li>
            <li class="interview">Interview: <span id="interviewCount">0</span></li>
            <li class="success">Success: <span id="successCount">0</span></li>
        </ul>

    </div>

    <div class="container">
        <canvas id="pie-chart"></canvas>
    </div>
</div>








<form asp-action="Index" method="get" class="navigation">

    <div class="navigationLeft">
        <input type="text"
               name="searchString"
               value="@ViewData["CurrentFilter"]"
               placeholder="Enter Job Name..." />
        @* <button type="submit" class="searchBtn">Search</button> *@
        
    </div>

    <div class="navigationRight">


        <a asp-action="Create" class="createBtn">Create New</a>
        <a asp-action="Index" class="resetBtn">Reset Search</a>
    </div>

</form>

<table class="table">
    <thead>
        <tr>
            <th>

                <a asp-action="Index" asp-route-sortOrder="@ViewData["NameSort"]"
                   asp-route-searchString="@ViewData["CurrentFilter"]" class="tableHeading @(ViewData["CurrentSort"]?.ToString().StartsWith("name") == true ? "selected" : "")">
                    @* @ViewData["NameTitle"] *@
                    Job Role
                    

                </a>
            </th>
            <th>
                @* @Html.DisplayNameFor(model => model.CompanyName) *@
                Company
            </th>
            <th>
                @* @Html.DisplayNameFor(model => model.JobDescription) *@
                Description
            </th>
            <th>
                <a asp-action="Index" asp-route-sortOrder="@ViewData["LocationSort"]"
                   asp-route-searchString="@ViewData["CurrentFilter"]" class="tableHeading @(ViewData["CurrentSort"]?.ToString().StartsWith("location") == true ? "selected" : "")">
                    @* @ViewData["LocationTitle"] *@
                    Location
                    
                </a>
            </th>
            <th>
                @* @Html.DisplayNameFor(model => model.JobUrl) *@
                URL
                
 
            </th>
            <th>
                <a asp-action="Index" asp-route-sortOrder="@ViewData["StatusSort"]"
                   asp-route-searchString="@ViewData["CurrentFilter"]" class="tableHeading @(ViewData["CurrentSort"]?.ToString().StartsWith("status") == true ? "selected" : "")">
                    @* @ViewData["StatusTitle"] *@
                    Status
                    
                </a>
            </th>
            <th>

                <a asp-action="Index" asp-route-sortOrder="@ViewData["DateSort"]"
                   asp-route-searchString="@ViewData["CurrentFilter"]" class="tableHeading @(ViewData["CurrentSort"]?.ToString().StartsWith("date") == true ? "selected" : "")">
                    @* @ViewData["DateTitle"] *@
                    Date
                    
                </a>
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(model => item.JobTitle)
            </td>
            <td> 
                @Html.DisplayFor(model => item.CompanyName) 
            </td>
            <td>
                @Html.DisplayFor(model => item.JobDescription)
            </td>
            <td>
                @Html.DisplayFor(model => item.Location)
            </td>
            <td>
                @Html.DisplayFor(model => item.JobUrl)
            </td>
            <td>
                @Html.DisplayFor(model => item.JobStatus)
            </td>
            <td>
                @Html.DisplayFor(model => item.DateApplied)
            </td>
            <td>
                    <a asp-action="Edit" asp-route-id="@item.Id" class="crudIcon editIcon">
                         <img src="~/Images/Icons/editIcon1.png" class="normalIcon" alt="Edit" /> <!--https://icon-icons.com/icon/pencil-striped-symbol-for-interface-edit-buttons/56782-->
                         <img src="~/Images/Icons/editIcon2.png" class="hoverIcon" alt="" />
                     </a>
                    <a asp-action="Details" asp-route-id="@item.Id" class="crudIcon detailsIcon">
                         <img src="~/Images/Icons/detailsIcon1.png" class="normalIcon" alt="Details" />  <!--https://icon-icons.com/icon/pencil-writing-on-a-paper-sheet/70422-->
                         <img src="~/Images/Icons/detailsIcon2.png" class="hoverIcon" alt="" />
                     </a>
                    <a asp-action="Delete" asp-route-id="@item.Id" class="crudIcon deleteIcon">
                         <img src="~/Images/Icons/deleteIcon.png" class="normalIcon" alt="Delete" /> <!--https://icon-icons.com/icon/trash-bin-delete-remove/67981-->
                         <img src="~/Images/Icons/deleteIcon2.png" class="hoverIcon" alt="" />
                     </a>
            </td>
        </tr>
}
    </tbody>
</table>



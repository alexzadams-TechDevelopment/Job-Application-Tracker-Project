@model IEnumerable<JobApplicationTracker.Models.Job>

@{
    ViewData["Title"] = "Index";
}

<link rel="stylesheet" href="~/css/JobList.css" />

<h1>Welcome [User]</h1>


<div class="status-summary">
    <h3>Job Application Summary</h3>

    <p>unApplied: <span id="unAppliedCount">0</span></p>
    <p>pending: <span id="pendingCount">0</span></p>
    <p>noReply: <span id="noReplyCount">0</span></p>
    <p>Rejected: <span id="rejectedCount">0</span></p>
    <p>interview: <span id="interviewCount">0</span></p>
    <p>success: <span id="successCount">0</span></p>
    
</div>



<p>
    <a asp-action="Create">Create New</a>
</p>


<form asp-action="Index" method="get" class="navigation">
    <input type="text"
           name="searchString"
           value="@ViewData["CurrentFilter"]"
           placeholder="Enter Job Name..." />

    <button type="submit" class="searchBtn">Search</button>

    <a asp-action="Index" class="ResetBtn">Reset Search</a>
</form>

<table class="table">
    <thead>
        <tr>
            <th>
                @* @Html.DisplayNameFor(model => model.JobName) *@

                <a asp-action="Index" asp-route-sortOrder="@ViewData["NameSort"]"
                   asp-route-searchString="@ViewData["CurrentFilter"]">
                    @ViewData["NameTitle"]
                    

                </a>
            </th>
            <th>
                @Html.DisplayNameFor(model => model.JobDescription)
            </th>
            <th>
                @* @Html.DisplayNameFor(model => model.Location) *@
                <a asp-action="Index" asp-route-sortOrder="@ViewData["LocationSort"]"
                   asp-route-searchString="@ViewData["CurrentFilter"]">
                    @ViewData["LocationTitle"]
                    
                </a>
            </th>
            <th>
                @Html.DisplayNameFor(model => model.JobUrl)
                
 
            </th>
            <th>
                @* @Html.DisplayNameFor(model => model.JobStatus) *@
                <a asp-action="Index" asp-route-sortOrder="@ViewData["StatusSort"]"
                   asp-route-searchString="@ViewData["CurrentFilter"]">
                    @ViewData["StatusTitle"]
                    
                </a>
            </th>
            <th>
                @* @Html.DisplayNameFor(model => model.DateApplied) *@

                <a asp-action="Index" asp-route-sortOrder="@ViewData["DateSort"]"
                   asp-route-searchString="@ViewData["CurrentFilter"]">
                    @ViewData["DateTitle"]
                    
                </a>
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(model => item.JobName)
            </td>
            <td>
                @Html.DisplayFor(model => item.JobDescription)
            </td>
            <td>
                @Html.DisplayFor(model => item.Location)
            </td>
            <td>
                @Html.DisplayFor(model => item.JobUrl)
            </td>
            <td>
                @Html.DisplayFor(model => item.JobStatus)
            </td>
            <td>
                @Html.DisplayFor(model => item.DateApplied)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.Id">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.Id">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.Id">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>


<script>
//TODO:: Create JS file for javascript features.

    document.addEventListener("DOMContentLoaded", function () {
        let unApplied = 0;
        let pending = 0;
        let noReply = 0;
        let rejected = 0;
        let interview = 0;
        let success = 0;

        // Get all job rows from the table
        const rows = document.querySelectorAll("table tbody tr");

        rows.forEach(function (row) {
            // Status is the fifth column (index 4)
            const status = row.cells[4].textContent.trim().toLowerCase();



            if (status === "unapplied") {
                unApplied++;
            }
            else if (status === "pending") {
                pending++;
            }
            else if (status === "no reply") {
                noReply++;
            }
            else if (status === "rejected") {
                rejected++;
            }           
            else if (status === "interview") {
                interview++;
            }     
            else if (status === "success") {
                success++;
            }
        });

        document.getElementById("unAppliedCount").textContent = unApplied;
        document.getElementById("pendingCount").textContent = pending;
        document.getElementById("noReplyCount").textContent = noReply;
        document.getElementById("rejectedCount").textContent = rejected;
        document.getElementById("interviewCount").textContent = interview;
        document.getElementById("successCount").textContent = success;
        



    });
</script>

